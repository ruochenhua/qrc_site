{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrc-cyber-money-tree",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrc-cyber-money-tree",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.qrc-eye.com,https://ruochenhua.github.io,http://127.0.0.1:8787,http://localhost:8787"
  }
}
